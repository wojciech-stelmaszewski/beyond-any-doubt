---
import type { MarkdownHeading } from "astro";

interface Entry {
  depth: number;
  slug: string;
  text: string;
  children: MarkdownHeading[];
}

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const sections: Entry[] = [];
for (const heading of headings) {
  if (heading.depth < 2 || heading.depth > 3) continue;
  if (heading.depth === 2 || sections.length === 0) {
    sections.push({ ...heading, children: [] });
    continue;
  }
  sections.at(-1)?.children.push(heading);
}
---

{
  sections.length > 0 && (
    <nav class="toc" aria-label="On this page">
      <details class="toc-fold">
        <summary>On this page</summary>
        <ol>
          {sections.map((section) => (
            <li>
              <a href={`#${section.slug}`}>{section.text}</a>
              {section.children.length > 0 && (
                <ol>
                  {section.children.map((child) => (
                    <li>
                      <a href={`#${child.slug}`}>{child.text}</a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}

<script>
  const fold = document.querySelector<HTMLDetailsElement>(".toc-fold");
  if (fold) {
    const wide = window.matchMedia("(min-width: 78rem)");
    const sync = () => {
      fold.open = wide.matches;
    };
    sync();
    wide.addEventListener("change", sync);
  }

  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]')];
  const headings = tocLinks
    .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((node): node is HTMLElement => node !== null);

  if (headings.length > 0) {
    const mark = () => {
      const line = 96;
      let current = headings[0];
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= line) current = heading;
      }
      for (const link of tocLinks) {
        link.ariaCurrent = link.hash === `#${current.id}` ? "true" : null;
      }
    };

    mark();
    window.addEventListener("scroll", mark, { passive: true });
  }
</script>
