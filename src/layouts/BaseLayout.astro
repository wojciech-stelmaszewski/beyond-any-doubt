---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/base.css";
import { site } from "../site";

interface Props {
  title: string;
  description: string;
  /** Root-relative path to this page's social card. */
  card?: string;
  /** Present only on posts, and what turns the page into an article. */
  article?: { published: Date; updated?: Date; tags?: readonly string[] };
}

const { title, description, card = "/og/site.png", article } = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url);
const cardUrl = new URL(card, site.url);

/* The home page is already called this; saying it twice reads as a stutter. */
const pageTitle = title === site.name ? site.name : `${title} — ${site.name}`;

/*
 * Structured data. Search engines will read the page without it, but it is what
 * gets the date and author shown next to a result rather than guessed at.
 */
const schema = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      image: cardUrl.href,
      datePublished: article.published.toISOString(),
      dateModified: (article.updated ?? article.published).toISOString(),
      author: { "@type": "Person", name: site.author },
      publisher: { "@type": "Organization", name: site.name },
      mainEntityOfPage: canonical.href,
      inLanguage: site.language,
      ...(article.tags?.length ? { keywords: article.tags.join(", ") } : {}),
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: site.name,
      description,
      url: site.url,
      inLanguage: site.language,
    };
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/*
      Two values, because the browser chrome should follow the page rather than
      flash the wrong colour when a reader in dark mode opens the site.
    */}
    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1216" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={cardUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/*
      Describes the card, not the page: a screen reader user meeting this link
      in a feed gets told what the picture shows.
    */}
    <meta property="og:image:alt" content={`${title} — ${site.name}`} />
    <meta property="og:locale" content="en_GB" />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.updated && (
            <meta property="article:modified_time" content={article.updated.toISOString()} />
          )}
          <meta property="article:author" content={site.author} />
          {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={cardUrl.href} />

    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />

    <link
      rel="preload"
      href="/fonts/stix-two-text-latin-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/*
      Inline and synchronous on purpose. The theme has to be settled before the
      first paint, or a reader who wants dark gets a full screen of white first.
      That rules out a bundled module, which is deferred by definition.
    */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const dark =
            stored === null
              ? matchMedia("(prefers-color-scheme: dark)").matches
              : stored === "dark";
          if (dark) document.documentElement.dataset.theme = "dark";
        } catch {
          /* Private mode can refuse localStorage; the light theme is a fine default. */
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  </head>
  <body>
    <div class="shell">
      <button class="theme-toggle" type="button" aria-pressed="false">
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2.2v3M12 18.8v3M2.2 12h3M18.8 12h3M5 5l2.1 2.1M16.9 16.9 19 19M19 5l-2.1 2.1M7.1 16.9 5 19" />
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.2 8.2 0 1 0 10.2 10.2z" />
        </svg>
        <span class="theme-toggle-label">Dark theme</span>
      </button>
      <slot />
    </div>
    <script>
      import "../scripts/theme.js";
    </script>
  </body>
</html>
